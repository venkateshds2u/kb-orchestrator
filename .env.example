# Copy to .env for local overrides. Required variables have no default and
# must be set; others show their defaults below.

KB_ORCHESTRATOR_KB_AGENT_BASE_URL=http://127.0.0.1:8000
KB_ORCHESTRATOR_KB_AGENT_AUTH_TOKEN=
KB_ORCHESTRATOR_HTTP_AUTH_TOKEN=

